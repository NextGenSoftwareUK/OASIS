# WEB10 WEB API
# Build context must be the repo root (C:/Source/OASIS2/).
# Railway Dockerfile path: Docker/Dockerfile.web10
# For local builds run from C:/Source/OASIS2/:
#   docker build -f Docker/Dockerfile.web10 -t oasis-web10-webapi .

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

ARG LIBRARIES_REPO=https://github.com/NextGenSoftwareUK/NextGenSoftware-Libraries.git
ARG HOLOCHAIN_REPO=https://github.com/holochain-open-dev/holochain-client-csharp.git
ARG LIBRARIES_COMMIT=8634ab8be426d2919111e75cadac9ff2901b7384
ARG HOLOCHAIN_COMMIT=8f47260109834c058e07767656dec4e55d54d8f2
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && git clone --no-checkout "${LIBRARIES_REPO}" /NextGenSoftware-Libraries \
    && git -C /NextGenSoftware-Libraries checkout --detach "${LIBRARIES_COMMIT}" \
    && git clone --no-checkout "${HOLOCHAIN_REPO}" /holochain-client-csharp \
    && git -C /holochain-client-csharp checkout --detach "${HOLOCHAIN_COMMIT}" \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG GITHUB_PAT
ARG OASIS_API_CORE_COMMIT=2baebfffe4c8fc0b3cb8b2ef75cf7d1509de2c48
ARG OASIS_ONODE_CORE_COMMIT=33956e6c27bdcca127b058675fbe13a4c5944f44
ARG ONODE_MANAGER_COMMIT=0abe9c2218d96e741990dd28fd6b2db4d50380f4
ARG STAR_ODK_COMMIT=43ab294cb7a2dc287cca7c54700ffadee9fe117e
ARG OASIS_WEB6_COMMIT=4921b5b3fa54b9713912cf115bcd47817a81ab20
ARG OGENGINE_CLIENT_COMMIT=d1539ecef171e5bd34ffebf359786776573b0f0a
ARG HOLONET_ORM_COMMIT=902851522a4485862ebebfcd843b85211854bddd
COPY Docker/clone-pinned-oasis-dependencies.sh /tmp/clone-pinned-oasis-dependencies.sh
RUN chmod +x /tmp/clone-pinned-oasis-dependencies.sh \
    && /tmp/clone-pinned-oasis-dependencies.sh \
    && rm /tmp/clone-pinned-oasis-dependencies.sh

RUN test -f "/src/OASIS Architecture/NextGenSoftware.OASIS.API.DNA/OASIS_DNA.json" || \
    cp "/src/OASIS Architecture/NextGenSoftware.OASIS.API.DNA/Default/OASIS_DNA.json" \
       "/src/OASIS Architecture/NextGenSoftware.OASIS.API.DNA/OASIS_DNA.json"

RUN test -f "/src/STAR ODK/NextGenSoftware.OASIS.STAR.STARDNA/DNA/OASIS_DNA.json" || \
    (mkdir -p "/src/STAR ODK/NextGenSoftware.OASIS.STAR.STARDNA/DNA" && \
     cp "/src/OASIS Architecture/NextGenSoftware.OASIS.API.DNA/OASIS_DNA.json" \
        "/src/STAR ODK/NextGenSoftware.OASIS.STAR.STARDNA/DNA/OASIS_DNA.json")

WORKDIR "/src/WEB10/NextGenSoftware.OASIS.Web10.WebAPI"
RUN dotnet restore "NextGenSoftware.OASIS.Web10.WebAPI.csproj"
RUN dotnet publish "NextGenSoftware.OASIS.Web10.WebAPI.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
COPY Docker/entrypoint.web10.sh /entrypoint.sh
RUN sed -i 's/\r//' /entrypoint.sh && chmod +x /entrypoint.sh

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
