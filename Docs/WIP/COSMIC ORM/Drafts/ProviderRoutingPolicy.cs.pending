using System;
using System.Collections.Generic;
using System.Linq;
using NextGenSoftware.OASIS.API.Core.Enums;

namespace NextGenSoftware.OASIS.API.Core.Configuration
{
    /// <summary>Explicit routing changes. Null means inherit the captured policy;
    /// an empty provider list is an explicit empty selection. Contains no provider
    /// instances, activation authority or usage-admission evidence.</summary>
    public sealed class ProviderRoutingOverrides
    {
        public bool? AutoFailoverEnabled { get; }
        public bool? AutoReplicationEnabled { get; }
        public bool? AutoLoadBalancingEnabled { get; }
        public IReadOnlyList<ProviderType> FailoverProviders { get; }
        public IReadOnlyList<ProviderType> ReplicationProviders { get; }
        public IReadOnlyList<ProviderType> LoadBalancingProviders { get; }

        public ProviderRoutingOverrides(bool? autoFailoverEnabled = null,
            bool? autoReplicationEnabled = null, bool? autoLoadBalancingEnabled = null,
            IEnumerable<ProviderType> failoverProviders = null,
            IEnumerable<ProviderType> replicationProviders = null,
            IEnumerable<ProviderType> loadBalancingProviders = null)
        {
            AutoFailoverEnabled = autoFailoverEnabled;
            AutoReplicationEnabled = autoReplicationEnabled;
            AutoLoadBalancingEnabled = autoLoadBalancingEnabled;
            FailoverProviders = Capture(failoverProviders);
            ReplicationProviders = Capture(replicationProviders);
            LoadBalancingProviders = Capture(loadBalancingProviders);
        }

        internal static IReadOnlyList<ProviderType> Capture(IEnumerable<ProviderType> values)
        {
            if (values == null) return null;
            var captured = values.Take(257).ToArray();
            if (captured.Length > 256 || captured.Distinct().Count() != captured.Length ||
                captured.Any(value => !Enum.IsDefined(typeof(ProviderType), value) ||
                    value == ProviderType.Default || value == ProviderType.None || value == ProviderType.All))
                throw new ArgumentException("Routing requires at most256 unique concrete providers.", nameof(values));
            return Array.AsReadOnly(captured);
        }
    }

    /// <summary>One immutable routing observation, including ordered lists and
    /// the captured preferred provider. It never grants record access, selects
    /// native signers, authorizes replication or establishes measured prices.</summary>
    public sealed class ProviderRoutingPolicy
    {
        public bool AutoFailoverEnabled { get; }
        public bool AutoReplicationEnabled { get; }
        public bool AutoLoadBalancingEnabled { get; }
        public ProviderType PreferredProvider { get; }
        public IReadOnlyList<ProviderType> FailoverProviders { get; }
        public IReadOnlyList<ProviderType> ReplicationProviders { get; }
        public IReadOnlyList<ProviderType> LoadBalancingProviders { get; }

        internal ProviderRoutingPolicy(bool failover, bool replication, bool loadBalancing,
            ProviderType preferredProvider, IEnumerable<ProviderType> failoverProviders,
            IEnumerable<ProviderType> replicationProviders, IEnumerable<ProviderType> loadBalancingProviders)
        {
            if (!Enum.IsDefined(typeof(ProviderType), preferredProvider) || preferredProvider == ProviderType.All ||
                preferredProvider == ProviderType.None)
                throw new ArgumentException("A valid captured preferred provider is required.", nameof(preferredProvider));
            AutoFailoverEnabled = failover;
            AutoReplicationEnabled = replication;
            AutoLoadBalancingEnabled = loadBalancing;
            PreferredProvider = preferredProvider;
            FailoverProviders = ProviderRoutingOverrides.Capture(failoverProviders ?? Array.Empty<ProviderType>());
            ReplicationProviders = ProviderRoutingOverrides.Capture(replicationProviders ?? Array.Empty<ProviderType>());
            LoadBalancingProviders = ProviderRoutingOverrides.Capture(loadBalancingProviders ?? Array.Empty<ProviderType>());
        }

        internal ProviderRoutingPolicy Apply(ProviderRoutingOverrides changes, ProviderType preferredProvider)
        {
            if (changes == null) throw new ArgumentNullException(nameof(changes));
            return new ProviderRoutingPolicy(changes.AutoFailoverEnabled ?? AutoFailoverEnabled,
                changes.AutoReplicationEnabled ?? AutoReplicationEnabled,
                changes.AutoLoadBalancingEnabled ?? AutoLoadBalancingEnabled,
                preferredProvider == ProviderType.Default ? PreferredProvider : preferredProvider,
                changes.FailoverProviders ?? FailoverProviders,
                changes.ReplicationProviders ?? ReplicationProviders,
                changes.LoadBalancingProviders ?? LoadBalancingProviders);
        }
    }
}
