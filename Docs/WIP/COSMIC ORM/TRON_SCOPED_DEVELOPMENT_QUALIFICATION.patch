+name: Qualify recovered authenticated TRON header client
+
+on:
+  push:
+    branches: [work/cosmic-cql-ton-public]
+    paths:
+      - '.github/workflows/qualify-tron-header-client.yml'
+      - 'Docker/oasis-dependency-versions.env'
+      - 'OASIS Architecture/NextGenSoftware.OASIS.API.Core'
+      - 'Providers/Blockchain/NextGenSoftware.OASIS.API.Providers.TRONOASIS/**'
+      - 'Providers/Blockchain/TestProjects/NextGenSoftware.OASIS.API.Providers.TRONOASIS.UnitTests/**'
+  workflow_dispatch:
+    inputs:
+      authenticated_native:
+        description: Run exact retained header catalogue with the configured dedicated TronGrid reader secret
+        required: false
+        type: boolean
+        default: false
+
+permissions:
+  contents: read
+
+jobs:
+  dictionary:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          path: OASIS
+          submodules: true
+          token: ${{ secrets.PRIVATE_SUBMODULE_PAT }}
+          persist-credentials: false
+      - name: Validate exact dependency pins
+        id: dependency
+        working-directory: OASIS
+        run: |
+          python3 -B Scripts/validate_railway_dependency_manifest.py --require-gitlinks
+          grep -E '^(LIBRARIES_COMMIT|HOLOCHAIN_COMMIT)=[0-9a-f]{40}$' Docker/oasis-dependency-versions.env >> "$GITHUB_OUTPUT"
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          repository: NextGenSoftwareUK/NextGenSoftware-Libraries
+          ref: ${{ steps.dependency.outputs.LIBRARIES_COMMIT }}
+          path: NextGenSoftware-Libraries
+          persist-credentials: false
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          repository: holochain-open-dev/holochain-client-csharp
+          ref: ${{ steps.dependency.outputs.HOLOCHAIN_COMMIT }}
+          path: holochain-client-csharp
+          persist-credentials: false
+      - uses: actions/setup-dotnet@v6
+        with:
+          dotnet-version: 10.0.x
+      - name: Verify capability HTTP and parser boundary without native service access
+        working-directory: OASIS
+        shell: pwsh
+        run: |
+          & Scripts/TestHosts/Invoke-WithProviderBuildLease.ps1 -Owner tron-header-client-ci -Operation {
+            dotnet test Providers/Blockchain/TestProjects/NextGenSoftware.OASIS.API.Providers.TRONOASIS.UnitTests --filter 'FullyQualifiedName~TronPublicHeaderMetadataTests&FullyQualifiedName!~RetainedNativeCatalogueRunsSharedManagerThreeAndTwo' /m:2 /nr:false /p:UseSharedCompilation=false --results-directory TestResults/TronHeaderClientCurrent --logger 'trx;LogFileName=controlled.trx'
+            if ($LASTEXITCODE) { throw 'TRON header controlled client qualification failed' }
+            [xml]$report = Get-Content TestResults/TronHeaderClientCurrent/controlled.trx
+            $counts = $report.TestRun.ResultSummary.Counters
+            if ($counts.passed -ne '38' -or $counts.total -ne '38' -or $counts.executed -ne '38') {
+              throw 'All thirty-eight controlled client cases must execute and pass without skips'
+            }
+          }
+      - name: Verify authenticated native headers only when explicitly requested
+        if: github.event_name == 'workflow_dispatch' && inputs.authenticated_native
+        working-directory: OASIS
+        shell: pwsh
+        env:
+          COSMIC_TRON_PUBLIC_READER_KEY: ${{ secrets.COSMIC_TRON_PUBLIC_READER_KEY }}
+        run: |
+          if ([string]::IsNullOrWhiteSpace($env:COSMIC_TRON_PUBLIC_READER_KEY)) { throw 'Configure the dedicated reader secret privately; no native request made.' }
+          $env:COSMIC_TRON_PUBLIC_SOURCE=(Resolve-Path 'Providers/Blockchain/TestProjects/NextGenSoftware.OASIS.API.Providers.TRONOASIS.UnitTests/Fixtures/tron-public-header-source.json').Path
+          if ((Get-FileHash -Algorithm SHA256 -LiteralPath $env:COSMIC_TRON_PUBLIC_SOURCE).Hash -cne '7F1C8FE3C35EF3C45EE31BE6EAEF72F34F8D10185A28E2177ACE267822E89C02') { throw 'Original separate catalogue bytes changed' }
+          dotnet test Providers/Blockchain/TestProjects/NextGenSoftware.OASIS.API.Providers.TRONOASIS.UnitTests --no-build --no-restore --filter FullyQualifiedName~TronPublicHeaderMetadataTests.RetainedNativeCatalogueRunsSharedManagerThreeAndTwo --results-directory TestResults/TronHeaderClientCurrent --logger 'trx;LogFileName=native.trx'
+          if ($LASTEXITCODE) { throw 'Authenticated TRON native verification failed; preserve outcome and do not retry' }
+          [xml]$native = Get-Content TestResults/TronHeaderClientCurrent/native.trx
+          $n=$native.TestRun.ResultSummary.Counters
+          if ($n.passed -ne '1' -or $n.total -ne '1' -or $n.executed -ne '1') { throw 'One real native case must execute and pass without skips' }
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: tron-header-client-qualification
+          path: |
+            OASIS/TestResults/TronHeaderClientCurrent/*.trx
+          if-no-files-found: error
+          retention-days: 30
