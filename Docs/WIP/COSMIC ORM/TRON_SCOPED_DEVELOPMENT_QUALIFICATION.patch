+          COSMIC_TRON_HEADER_NATIVE_HTTP: owned-loopback
+          COSMIC_REVIEWED_PUBLIC_MONGO_NATIVE: owned-local-27029
+        run: |
+          dotnet test ONODE/NextGenSoftware.OASIS.API.ONODE.WebAPI.UnitTests --no-build --no-restore /m:2 /nr:false /p:UseSharedCompilation=false --filter FullyQualifiedName~AuthenticatedTronHeadersAndPrivateMongoCopiesOverHttp --results-directory TestResults/TronHeaderWeb4Current --logger 'trx;LogFileName=native-http.trx'
