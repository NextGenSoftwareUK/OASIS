+        if: always() && github.event_name == 'workflow_dispatch' && inputs.authenticated_native_http
+        uses: actions/upload-artifact@v7
+        with:
+          name: tron-header-web4-cleanup
+          path: OASIS/TestResults/TronHeaderWeb4Current/mongo-*.json
+          if-no-files-found: error
+          retention-days: 30
