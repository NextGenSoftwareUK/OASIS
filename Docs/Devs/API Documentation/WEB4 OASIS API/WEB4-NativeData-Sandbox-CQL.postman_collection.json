{
  "info": {
    "name": "WEB4 Native Data, Sandbox and CQL",
    "description": "Native data import (including bring-your-own and saved connections), the public sandbox, and CQL. Generated by Scripts/generate_native_data_postman.py: edit the script, not this file. No credentials are stored here; set username, password, mongoUri and the other variables in a Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "web4BaseUrl",
      "value": "https://dev.api.web4.oasisomniverse.one"
    },
    {
      "key": "bearerToken",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "provider",
      "value": "MongoDBOASIS"
    },
    {
      "key": "sourceName",
      "value": "customers"
    },
    {
      "key": "connectionName",
      "value": "my-database"
    },
    {
      "key": "mongoUri",
      "value": ""
    },
    {
      "key": "mongoDatabase",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sign in",
      "item": [
        {
          "name": "Sign in (stores bearerToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{web4BaseUrl}}/api/avatar/authenticate",
            "description": "Sign in with your own avatar. Put username and password in your Postman environment, never in the collection.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const avatar = (body.result && body.result.result) || body.result || {};",
                  "if (avatar.jwtToken) pm.collectionVariables.set('bearerToken', avatar.jwtToken);",
                  "pm.test('Signed in', () => pm.expect(avatar.jwtToken).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sandbox (only where DNA OASIS.Sandbox.Enabled is true; otherwise 404)",
      "item": [
        {
          "name": "Start a demo session (creates a throwaway avatar and signs it in)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/session",
            "description": "Creates a verified demo avatar named <prefix><8 hex> that is deleted with all its data after DNA OASIS.Sandbox.DemoAvatarRetentionMinutes. Limited per address per hour and per day (HTTP 429)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const avatar = body.result || {};",
                  "if (avatar.jwtToken) pm.collectionVariables.set('bearerToken', avatar.jwtToken);",
                  "pm.test('Demo session', () => pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Providers this avatar has taken offline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/faults"
          }
        },
        {
          "name": "Requests each offline provider has refused",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/refusals"
          }
        },
        {
          "name": "Take a provider offline (5-120 seconds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/providers/{{provider}}/offline?seconds=30",
            "description": "Only for your own requests; nobody else is affected."
          }
        },
        {
          "name": "Bring a provider back online",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/providers/{{provider}}/online"
          }
        },
        {
          "name": "Write the demo shop into the sandbox native-apps databases",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/sandbox/native-demo",
            "description": "Idempotent. Writes customers, products and orders into the demo Mongo, SQLite and Neo4j stores so Native Data can import them."
          }
        }
      ]
    },
    {
      "name": "Native Data import",
      "item": [
        {
          "name": "Providers that can import a connection you supply",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/native-data/providers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Demo store (no connection: Wizard avatar, or the sandbox)",
          "item": [
            {
              "name": "Sources of the server's configured demo store",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources"
              }
            }
          ]
        },
        {
          "name": "Your own database (send a connection)",
          "item": [
            {
              "name": "List sources",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources",
                "description": "Nothing is saved. MongoDB shown: uri + database. Other providers take their own settings (see Docs/Devs/NATIVE_DATA_IMPORT.md): Neo4j uri/username/password, SQLite fileName/fileBase64, Cosmos endpoint/key/database, SOLID podUrl/containers, ActivityPub instanceUrl/accessToken, IPFS apiUrl/paths, Solana rpcUrl/programs.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connection\": {\n    \"uri\": \"{{mongoUri}}\",\n    \"database\": \"{{mongoDatabase}}\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Preview the first records and the holons they would become",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/preview?count=5",
                "description": "Saves nothing.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connection\": {\n    \"uri\": \"{{mongoUri}}\",\n    \"database\": \"{{mongoDatabase}}\"\n  },\n  \"mapping\": {\n    \"sourceName\": \"{{sourceName}}\",\n    \"nameField\": \"Name\",\n    \"excludedFields\": [\n      \"internalNotes\"\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Import one source",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/import",
                "description": "Running it again updates the same holons instead of creating new ones.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connection\": {\n    \"uri\": \"{{mongoUri}}\",\n    \"database\": \"{{mongoDatabase}}\"\n  },\n  \"mapping\": {\n    \"sourceName\": \"{{sourceName}}\",\n    \"nameField\": \"Name\",\n    \"excludedFields\": [\n      \"internalNotes\"\n    ]\n  },\n  \"pageSize\": 200,\n  \"maximumRecords\": 1000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Import every source",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/import-all",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connection\": {\n    \"uri\": \"{{mongoUri}}\",\n    \"database\": \"{{mongoDatabase}}\"\n  },\n  \"mappings\": {\n    \"{{sourceName}}\": {\n      \"sourceName\": \"{{sourceName}}\",\n      \"nameField\": \"Name\",\n      \"excludedFields\": [\n        \"internalNotes\"\n      ]\n    }\n  },\n  \"pageSize\": 200,\n  \"maximumRecordsPerSource\": 1000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "name": "Saved connections (encrypted with DNA OASIS.NativeImport.ConnectionEncryptionKey; refused if no key is set)",
          "item": [
            {
              "name": "List saved connection names",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/connections",
                "description": "Names only. The settings and secrets are never returned."
              }
            },
            {
              "name": "Save a connection",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/connections/{{connectionName}}",
                "description": "Body is the connection settings for that provider. Name: 1-64 letters, digits, spaces, '-' or '_'. Limited by DNA OASIS.NativeImport.MaximumSavedConnectionsPerAvatar.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"uri\": \"{{mongoUri}}\",\n  \"database\": \"{{mongoDatabase}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "List sources using a saved connection",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources",
                "description": "Send connectionName instead of connection. Sending both is refused (NATIVE_IMPORT_CONNECTION_AMBIGUOUS).",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionName\": \"{{connectionName}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Preview using a saved connection",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/preview?count=5",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionName\": \"{{connectionName}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Import using a saved connection",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/import",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionName\": \"{{connectionName}}\",\n  \"pageSize\": 200,\n  \"maximumRecords\": 1000\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Import every source using a saved connection",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/import-all",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"connectionName\": \"{{connectionName}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Delete a saved connection",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/connections/{{connectionName}}"
              }
            }
          ]
        },
        {
          "name": "Saved mappings (how a source becomes holons)",
          "item": [
            {
              "name": "List saved mappings for a provider",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/mappings"
              }
            },
            {
              "name": "Save a mapping",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/mapping",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sourceName\": \"{{sourceName}}\",\n  \"nameField\": \"Name\",\n  \"excludedFields\": [\n    \"internalNotes\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Delete a mapping",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{bearerToken}}"
                  }
                ],
                "url": "{{web4BaseUrl}}/api/native-data/{{provider}}/sources/{{sourceName}}/mapping"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CQL (POST a bounded JSON query; at most 32,768 bytes)",
      "item": [
        {
          "name": "Basic query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required; use a new value for each new intent. Reusing one is refused with 409."
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/data/query-cql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{provider}}\",\n  \"filters\": [\n    {\n      \"field\": \"Name\",\n      \"scalar\": \"String\",\n      \"operator\": \"Contains\",\n      \"value\": \"coffee\"\n    }\n  ],\n  \"orderBy\": \"Name\",\n  \"descending\": false,\n  \"skip\": 0,\n  \"take\": 10,\n  \"includeMetadata\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Scalar (count)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required; use a new value for each new intent. Reusing one is refused with 409."
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/data/query-cql/scalar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{provider}}\",\n  \"operation\": \"LongCount\",\n  \"filters\": [\n    {\n      \"field\": \"Name\",\n      \"scalar\": \"String\",\n      \"operator\": \"Contains\",\n      \"value\": \"coffee\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Projection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required; use a new value for each new intent. Reusing one is refused with 409."
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/data/query-cql/projection",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{provider}}\",\n  \"filters\": [\n    {\n      \"field\": \"Name\",\n      \"scalar\": \"String\",\n      \"operator\": \"Contains\",\n      \"value\": \"coffee\"\n    }\n  ],\n  \"columns\": [\n    {\n      \"alias\": \"name\",\n      \"field\": \"Name\"\n    }\n  ],\n  \"take\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Federation across providers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "description": "Required; use a new value for each new intent. Reusing one is refused with 409."
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}"
              }
            ],
            "url": "{{web4BaseUrl}}/api/data/query-cql/federation",
            "description": "The other routes (indexed, indexed/scalar, grouped, join, composition) take the Cql*V1Request shapes in ONODE/.../Models/Data and are documented in Docs/Devs/CQL_WEB4_AND_STAR_CLI.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope\": \"CurrentDefault\",\n  \"providers\": [],\n  \"identityMode\": \"PreserveCopies\",\n  \"source\": {\n    \"filters\": [\n      {\n        \"field\": \"Name\",\n        \"scalar\": \"String\",\n        \"operator\": \"Contains\",\n        \"value\": \"coffee\"\n      }\n    ],\n    \"orderBy\": \"Name\",\n    \"take\": 10\n  },\n  \"take\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
