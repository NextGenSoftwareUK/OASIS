# Ignore Node.js files to prevent Railpack detection
package.json
package-lock.json
node_modules/

# Ignore development files
*.md
*.txt
*.log
.git/
.vscode/
.idea/

# Ignore build outputs
bin/
obj/
build/
dist/

# Ignore test projects and their outputs. Do not use name-wide *Test* patterns:
# WEB4 has production runtime types such as TestDataHelper and
# TestDataResponseFilter that are compiled into the deployed application.
**/TestHarness/
**/UnitTests/
**/IntegrationTests/
**/TestResults/

# Ignore documentation
Docs/
Images/
Logos/

# Ignore archived files
Archived/

# Ignore other deployment configs
railway-deploy/
