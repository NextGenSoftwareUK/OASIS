<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OnodeServiceProject)" />
  </ItemGroup>
  <Target Name="RequireServiceSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(OnodeServiceProject)' == ''" Text="Exact candidate ONODE service project is required." />
  </Target>
</Project>
