<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageId>NextGenSoftware.OASIS.Edge.NearbySync</PackageId>
    <Description>Offline nearby-device HyperDrive sync for the OASIS Edge Runtime: Bluetooth LE, LAN/Wi-Fi Direct, and multi-hop mesh relay.</Description>
    <Version>1.0.0</Version>
    <Authors>David Ellams (NextGen Software Ltd)</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../NextGenSoftware.OASIS.HyperDrive.Synchronization/NextGenSoftware.OASIS.HyperDrive.Synchronization.csproj" />
    <ProjectReference Include="../NextGenSoftware.OASIS.Contracts/NextGenSoftware.OASIS.Contracts.csproj" />
  </ItemGroup>
</Project>
