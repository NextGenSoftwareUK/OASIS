#!/bin/sh
# Validate Railway dependency pins in every pushed commit, independent of local checkout/index state.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
PY=
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue
  git cat-file -e "$local_oid" || exit 1
  # Non-commit tags cannot select a deployment source.
  snapshot=$(git rev-parse --verify "${local_oid}^{commit}" 2>/dev/null) || continue
  applicable=$(git ls-tree -r --name-only "$snapshot" -- Docker/oasis-dependency-versions.env Docker/Dockerfile.web4 Docker/Dockerfile.web5 Docker/Dockerfile.web6 Docker/Dockerfile.web7 Docker/Dockerfile.web8 Docker/Dockerfile.web9 Docker/Dockerfile.web10) || exit 1
  # Legacy trees without WEB4-WEB10 deployment inputs are outside this policy.
  [ -z "$applicable" ] && continue
  if [ -z "$PY" ]; then
    for candidate in python3 python py; do
      if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "" >/dev/null 2>&1; then PY=$candidate; break; fi
    done
    if [ -z "$PY" ]; then
      echo "pre-push: Python is required to verify Railway dependency pins." >&2
      exit 1
    fi
  fi
  if ! "$PY" Scripts/validate_railway_dependency_manifest.py --require-gitlinks --ref "$snapshot"; then
    echo "pre-push: Railway dependency verification failed for $local_ref ($snapshot)." >&2
    exit 1
  fi
done
exit 0
