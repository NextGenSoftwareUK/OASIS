#!/bin/sh
# Refuses a push when Railway's dependency pins do not match the parent gitlinks.
# Enable once per clone:  git config core.hooksPath .githooks
# Fix a refusal with:     python Scripts/sync_railway_dependency_manifest.py && git commit -am "sync Railway pins"
# (CI also corrects this on Development/master, but fixing it before the push avoids a second deploy.)
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
[ -f Scripts/sync_railway_dependency_manifest.py ] || exit 0
# Windows may expose a nonfunctional Microsoft Store alias named python3.
PY=
for candidate in python3 python py; do
  bin=$(command -v "$candidate") || continue
  if "$bin" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    PY=$bin
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-push: a working Python 3.9+ interpreter is required to validate Railway pins." >&2
  exit 1
fi
while read -r local_ref local_oid remote_ref remote_oid; do
  # Git supplies a zero local object ID for ref deletions, which deploy nothing.
  [ "$local_oid" = 0000000000000000000000000000000000000000 ] && continue
  commit=$(git rev-parse --verify "${local_oid}^{commit}" 2>/dev/null) || continue
  # Legacy branches can predate the Railway WEB4 Dockerfile.
  git cat-file -e "$commit:Docker/Dockerfile.web4" 2>/dev/null || continue
  if ! "$PY" Scripts/sync_railway_dependency_manifest.py --check-ref "$commit"; then
    echo "pre-push: Railway dependency pins do not match gitlinks in $commit ($local_ref -> $remote_ref)." >&2
    echo "Synchronize and commit the Railway manifest on the revision being pushed." >&2
    exit 1
  fi
  # Development advances must preserve the previously deployed dependency history.
  # Source rewrites need explicit reconciliation, never an automatic divergent-tip replacement.
  if [ "$remote_ref" = refs/heads/Development ] &&
     [ "$remote_oid" != 0000000000000000000000000000000000000000 ]; then
    if ! "$PY" Scripts/validate_dependency_ancestry.py --base "$remote_oid" --ref "$commit"; then
      echo "pre-push: Development dependency history would be lost or cannot be verified." >&2
      exit 1
    fi
  fi
done
exit 0
