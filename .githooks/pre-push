#!/bin/sh
# Refuses a push when Railway's dependency pins do not match the parent gitlinks.
# Enable once per clone:  git config core.hooksPath .githooks
# Fix a refusal with:     python Scripts/sync_railway_dependency_manifest.py && git commit -am "sync Railway pins"
# (CI also corrects this on Development/master, but fixing it before the push avoids a second deploy.)
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
[ -f Scripts/sync_railway_dependency_manifest.py ] || exit 0
# Windows may expose a nonfunctional Microsoft Store alias named python3.
PY=
for candidate in python3 python; do
  bin=$(command -v "$candidate") || continue
  if "$bin" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    PY=$bin
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-push: a working Python 3.9+ interpreter is required to validate Railway pins." >&2
  exit 1
fi
if ! "$PY" Scripts/sync_railway_dependency_manifest.py --check; then
  echo "pre-push: Docker/oasis-dependency-versions.env does not match the submodule gitlinks." >&2
  echo "Railway builds the pinned commits, so this change would not ship. Run:" >&2
  echo "  python Scripts/sync_railway_dependency_manifest.py && git commit -am 'sync Railway pins'" >&2
  exit 1
fi
exit 0
