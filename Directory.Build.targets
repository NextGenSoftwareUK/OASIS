<Project>
  <Import Project="$(MSBuildThisFileDirectory)External Libs/IpfsSdk.AppReferences.props"
    Condition="'$(TargetFramework)' == 'net10.0' and ($([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.WebAPI')) or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.WebAPI.UnitTests')))" />
  <!-- Solnet brings Chaos.NaCl.Standard transitively; HoloNET supplies the
       pinned source implementation with the same assembly identity. Resolve
       that identity once, before compilation and runtime file collection. -->
  <Target Name="SelectCanonicalChaosNaCl" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_CanonicalChaosNaCl Include="@(ReferencePath)"
        Condition="'%(ReferencePath.Filename)' == 'Chaos.NaCl' and '%(ReferencePath.NuGetPackageId)' != 'Chaos.NaCl.Standard'" />
      <_PackagedChaosNaCl Include="@(ReferencePath)"
        Condition="'%(ReferencePath.NuGetPackageId)' == 'Chaos.NaCl.Standard'" />
    </ItemGroup>
    <Error Condition="'@(_CanonicalChaosNaCl)' != '' and '@(_PackagedChaosNaCl)' != '' and '@(_CanonicalChaosNaCl->Count())' != '1'"
      Text="The crypto dependency graph must contain exactly one pinned HoloNET Chaos.NaCl implementation." />
    <ItemGroup Condition="'@(_CanonicalChaosNaCl)' != '' and '@(_PackagedChaosNaCl)' != ''">
      <ReferencePath Remove="@(_PackagedChaosNaCl)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Chaos.NaCl.Standard'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
        Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Chaos.NaCl.Standard'" />
    </ItemGroup>
  </Target>
  <!-- GHSA-x33c-w48q-qrgc (CVE-2026-114149): Microsoft.AspNetCore.WebUtilities 8.0.0-8.0.33,
       9.0.0-9.0.22 and 10.0.0-10.0.14 are vulnerable. Resend and StrawberryShake pull old
       versions transitively. Pin the patched version for every project; PrivateAssets keeps it
       out of the NuGet dependencies of packages we publish. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="9.0.23" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.34" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
</Project>
