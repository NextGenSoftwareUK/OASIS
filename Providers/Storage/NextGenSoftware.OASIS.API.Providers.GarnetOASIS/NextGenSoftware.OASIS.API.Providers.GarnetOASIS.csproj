<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.GarnetOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.GarnetOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.GarnetOASIS</PackageId>
