<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>NextGenSoftware.OASIS.API.Providers.DenoDeployOASIS</PackageId>
    <Company>NextGen Software Ltd</Company>
    <Product>WEB4 OASIS API Deno Deploy OASIS Provider</Product>
    <Title>WEB4 OASIS API Deno Deploy OASIS Provider</Title>
    <Summary>Deno Deploy Edge Serverless OASIS Provider -- OASIS avatar and holon storage via Deno KV on Deno Deploy's global edge network. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to Deno Deploy -- the edge-native serverless platform built on the Deno runtime. OASIS avatars and holons are stored as Deno KV entries served globally with sub-millisecond edge latency. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen Software Ltd)</Authors>
    <PackageTags>OASIS API; Native; Integrated; WEB4; Provider; Deno; Deploy; Edge; Serverless</PackageTags>
    <PackageReleaseNotes>- Initial release as part of OASIS Omniverse ecosystem expansion.
- Implements OASISStorageProviderBase + IOASISDBStorageProvider for Deno Deploy edge KV.
- Upgraded to .NET 10.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.1</Version>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

</Project>
