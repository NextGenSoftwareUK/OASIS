<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.PostgreSQLOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.PostgreSQLOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.PostgreSQLOASIS</PackageId>
    <Company>NextGen World Ltd</Company>
    <Product>WEB4 OASIS API PostgreSQL OASIS Provider</Product>
    <Title>WEB4 OASIS API PostgreSQL OASIS Provider</Title>
    <Summary>PostgreSQL OASIS Provider — open-source relational database storage for OASIS holons and avatars. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to PostgreSQL — the world's most advanced open-source relational database. Stores OASIS holons and avatars using Npgsql (ADO.NET) with indexed lookup columns and full JSON serialisation. Compatible with PostgreSQL 12+ and managed services (Supabase, Neon, RDS, Azure). Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen World Ltd)</Authors>
    <PackageTags>OASIS API; PostgreSQL; Postgres; Database; WEB4; Provider</PackageTags>
    <PackageReleaseNotes>- Initial release of PostgreSQL OASIS provider.
- Full implementation of all OASIS storage provider interfaces.
- Uses Npgsql ADO.NET with upsert (INSERT ... ON CONFLICT) and JSON blob storage.
- Compatible with PostgreSQL 12+, Supabase, Neon, AWS RDS, Azure Database for PostgreSQL.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen World Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
