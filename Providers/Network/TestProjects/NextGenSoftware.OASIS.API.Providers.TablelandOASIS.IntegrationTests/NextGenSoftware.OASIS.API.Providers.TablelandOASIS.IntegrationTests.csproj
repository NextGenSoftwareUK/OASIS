<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../NextGenSoftware.OASIS.API.Providers.TablelandOASIS/NextGenSoftware.OASIS.API.Providers.TablelandOASIS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The npm fixture (and its node_modules) is not part of the test assembly. -->
    <Compile Remove="fixture/**" />
    <None Remove="fixture/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="TablelandNativeStorageConformanceTests.cs" />
    <Compile Include="../../../Shared/TestSupport/CoreStorageConformance.cs" Link="TestSupport/CoreStorageConformance.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' != 'true'">
    <Compile Remove="TablelandNativeStorageConformanceTests.cs" />
  </ItemGroup>
</Project>
