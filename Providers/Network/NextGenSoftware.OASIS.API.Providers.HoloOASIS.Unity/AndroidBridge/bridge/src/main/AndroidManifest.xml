<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The embedded conductor needs network access for iroh, bootstrap and relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 11+ package visibility: lets the bridge detect the shared Holochain Service Runtime app. -->
    <queries>
        <package android:name="org.holochain.androidserviceruntime.app" />
    </queries>
</manifest>
