<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>NextGenSoftware.OASIS.API.Providers.ArweaveOASIS</PackageId>
    <Company>NextGen Software Ltd</Company>
    <Product>WEB4 OASIS API ArweaveOASIS Provider</Product>
