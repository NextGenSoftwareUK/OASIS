<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.BasechainOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.BasechainOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.BasechainOASIS</PackageId>
    <Company>NextGen Software Ltd</Company>
    <Product>WEB4 OASIS API Basechain OASIS Provider</Product>
    <Title>WEB4 OASIS API Basechain OASIS Provider</Title>
    <Summary>Basechain (Loom Network) OASIS Provider — EVM-compatible delegated-PoS sidechain. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to Basechain (formerly Loom Network), an EVM-compatible delegated-PoS sidechain, via standard Ethereum JSON-RPC. Maps EVM addresses to OASIS Avatars and transactions to OASIS Holons. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <Authors>David Ellams (NextGen Software Ltd)</Authors>
    <PackageTags>OASIS API; Basechain; Loom Network; EVM; Blockchain; WEB4; Provider</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.1" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
