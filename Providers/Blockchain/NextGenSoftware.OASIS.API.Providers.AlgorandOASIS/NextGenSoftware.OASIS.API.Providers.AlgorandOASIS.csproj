<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.AlgorandOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.AlgorandOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.AlgorandOASIS</PackageId>
    <Company>NextGen Software Ltd</Company>
    <Product>WEB4 OASIS API Algorand OASIS Provider</Product>
    <Title>WEB4 OASIS API Algorand OASIS Provider</Title>
    <Summary>Algorand blockchain OASIS Provider — pure-PoS Layer-1 chain. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to the Algorand pure-PoS blockchain via the Algod REST API (Algonode.io). Maps Algorand accounts to OASIS Avatars and transactions/ASAs to OASIS Holons. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <Authors>David Ellams (NextGen Software Ltd)</Authors>
    <PackageTags>OASIS API; Algorand; Blockchain; ALGO; ASA; WEB4; Provider</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.1" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
