<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NextGenSoftware.OASIS.API.Providers.AlgorandOASIS\NextGenSoftware.OASIS.API.Providers.AlgorandOASIS.csproj" />
    <ProjectReference Include="..\..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WithAlgorandBootLoader)' == 'true'">
    <ProjectReference Include="..\..\..\..\OASIS Architecture\NextGenSoftware.OASIS.OASISBootLoader\NextGenSoftware.OASIS.OASISBootLoader.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(WithAlgorandBootLoader)' != 'true'">
    <Compile Remove="AlgorandBootLoaderTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="AlgorandNativeStorageConformanceTests.cs" />
    <Compile Include="../../../Shared/TestSupport/CoreStorageConformance.cs" Link="TestSupport/CoreStorageConformance.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' != 'true'">
    <Compile Remove="AlgorandNativeStorageConformanceTests.cs" />
  </ItemGroup>
</Project>
