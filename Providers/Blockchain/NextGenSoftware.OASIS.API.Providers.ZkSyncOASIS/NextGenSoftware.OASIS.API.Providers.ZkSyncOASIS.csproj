<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <PackageId>NextGenSoftware.OASIS.API.Providers.zkSyncOASIS</PackageId>
	  <Company>NextGen Software Ltd</Company>
	  <Product>WEB4 OASIS API zkSync OASIS Provider</Product>
	  <Title>WEB4 OASIS API zkSync OASIS Provider</Title>
	  <Summary>zkSync OASIS Provider — ZK Rollup EVM L2 for OASIS holons and avatars. https://oasisomniverse.one</Summary>
	  <Description>Connects the OASIS to zkSync Era — a ZK rollup EVM L2 with native account abstraction (chain ID 324). Stores OASIS holons, avatars, and NFTs on zkSync Mainnet. Part of the OASIS HOT-Swappable Provider Architecture.</Description>
	  <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
	  <PackageIcon>OASIS.jpg</PackageIcon>
	  <Authors>David Ellams (NextGen Software Ltd)</Authors>
	  <PackageTags>OASIS API; WEB4; Provider; zkSync; ZK Rollup; EVM; Blockchain</PackageTags>
	  <PackageReleaseNotes>- Initial release of zkSyncOASIS provider.</PackageReleaseNotes>
	  <RepositoryType>git</RepositoryType>
	  <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
	  <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	  <Version>2.0.1</Version>
	  <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg"><PackagePath>\</PackagePath><Pack>True</Pack></None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.1" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
    <ProjectReference Include="..\NextGenSoftware.OASIS.API.Providers.Web3CoreOASIS\NextGenSoftware.OASIS.API.Providers.Web3CoreOASIS.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nethereum.HdWallet" Version="4.25.0" />
    <PackageReference Include="Nethereum.RPC" Version="4.25.0" />
    <PackageReference Include="Nethereum.Signer" Version="4.25.0" />
    <PackageReference Include="Nethereum.Web3" Version="4.25.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
