<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.StellarOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.StellarOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.StellarOASIS</PackageId>
    <Company>NextGen Software Ltd</Company>
    <Product>WEB4 OASIS API Stellar OASIS Provider</Product>
    <Title>WEB4 OASIS API Stellar OASIS Provider</Title>
    <Summary>Stellar blockchain OASIS Provider — decentralised payments and asset issuance via the Stellar Horizon REST API. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to the Stellar network — a fast, low-cost, carbon-neutral blockchain for payments and asset issuance. Uses the public Stellar Horizon REST API (no SDK dependency). Stellar accounts map to OASIS avatars; Stellar transactions and data entries map to OASIS holons. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <Authors>David Ellams (NextGen Software Ltd)</Authors>
    <PackageTags>OASIS API; Stellar; Blockchain; WEB4; Provider</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.1" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
