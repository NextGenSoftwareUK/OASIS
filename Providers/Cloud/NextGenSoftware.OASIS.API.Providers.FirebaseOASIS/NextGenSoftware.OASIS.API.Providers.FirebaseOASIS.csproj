<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.FirebaseOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.FirebaseOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.FirebaseOASIS</PackageId>
    <Company>NextGen World Ltd</Company>
    <Product>WEB4 OASIS API Firebase OASIS Provider</Product>
    <Title>WEB4 OASIS API Firebase OASIS Provider</Title>
    <Summary>Firebase Realtime Database / Firestore OASIS Provider — Google cloud storage for OASIS holons and avatars. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to Google Firebase Realtime Database using the Firebase REST API. Stores OASIS holons and avatars as JSON documents. No Firebase SDK required — uses System.Net.Http. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen World Ltd)</Authors>
    <PackageTags>OASIS API; Firebase; Google; Cloud; WEB4; Provider; Realtime Database</PackageTags>
    <PackageReleaseNotes>- Initial release of Firebase OASIS provider.
- Uses Firebase Realtime Database REST API — no Firebase SDK dependency.
- Stores avatars under /oasis_avatars/{id}.json and holons under /oasis_holons/{id}.json.
- Supports optional Firebase ID token authentication.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen World Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
