<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.SupabaseOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.SupabaseOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.SupabaseOASIS</PackageId>
    <Company>NextGen World Ltd</Company>
    <Product>WEB4 OASIS API Supabase OASIS Provider</Product>
    <Title>WEB4 OASIS API Supabase OASIS Provider</Title>
    <Summary>Supabase OASIS Provider — open-source Firebase alternative with PostgreSQL backend for OASIS holons and avatars. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to Supabase via the PostgREST REST API. Uses Supabase's auto-generated REST interface to store OASIS holons and avatars in PostgreSQL. No Supabase SDK required — uses System.Net.Http. Compatible with Supabase cloud and self-hosted instances. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen World Ltd)</Authors>
    <PackageTags>OASIS API; Supabase; PostgreSQL; Cloud; WEB4; Provider</PackageTags>
    <PackageReleaseNotes>- Initial release of Supabase OASIS provider.
- Uses Supabase PostgREST REST API — no Supabase SDK dependency.
- Tables: oasis_avatars, oasis_avatar_details, oasis_holons (create via Supabase SQL editor).
- Supports anon key and service role key authentication.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen World Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
