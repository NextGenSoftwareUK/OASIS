<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.AppwriteOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.AppwriteOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.AppwriteOASIS</PackageId>
    <Company>NextGen World Ltd</Company>
    <Product>WEB4 OASIS API Appwrite OASIS Provider</Product>
    <Title>WEB4 OASIS API Appwrite OASIS Provider</Title>
    <Summary>Appwrite OASIS Provider — open-source self-hosted backend platform REST API for OASIS holons and avatars. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to Appwrite via its Databases REST API. Appwrite is an open-source, self-hostable Firebase/Supabase alternative with auth, databases, storage, and functions. No Appwrite SDK required — uses System.Net.Http. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen World Ltd)</Authors>
    <PackageTags>OASIS API; Appwrite; Self-Hosted; Cloud; WEB4; Provider</PackageTags>
    <PackageReleaseNotes>- Initial release of Appwrite OASIS provider.
- Uses Appwrite Databases REST API — no Appwrite SDK dependency.
- Collections: oasis_avatars, oasis_avatar_details, oasis_holons (create in Appwrite console).
- Supports API key authentication (X-Appwrite-Key header).</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen World Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.1" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
