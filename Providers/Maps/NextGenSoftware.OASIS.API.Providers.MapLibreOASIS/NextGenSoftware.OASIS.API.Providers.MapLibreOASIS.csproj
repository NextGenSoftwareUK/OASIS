<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>NextGenSoftware.OASIS.API.Providers.MapLibreOASIS</PackageId>
        <Company>NextGen Software Ltd</Company>
        <Product>WEB4 OASIS API MapLibre OASIS Provider</Product>
        <Title>WEB4 OASIS API MapLibre OASIS Provider</Title>
        <Summary>MapLibre GL OASIS Map Provider -- open-source, self-hostable vector tile rendering for OASIS avatars and holons. https://oasisomniverse.one</Summary>
        <Description>Connects the OASIS to MapLibre GL -- the community-driven open-source fork of Mapbox GL JS. Enables self-hosted, privacy-preserving geo-spatial visualisation of OASIS avatars and holons without vendor lock-in. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
        <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
        <PackageIcon>OASIS.jpg</PackageIcon>
        <Authors>David Ellams (NextGen Software Ltd)</Authors>
        <PackageTags>OASIS API; Native; Integrated; WEB4; Provider; MapLibre; OpenSource; Maps</PackageTags>
        <PackageReleaseNotes>- Initial release as part of OASIS Omniverse ecosystem expansion.
- Implements IOASISMapProvider for MapLibre GL.
- Upgraded to .NET 10.</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
        <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Version>2.0.1</Version>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
        <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

</Project>
