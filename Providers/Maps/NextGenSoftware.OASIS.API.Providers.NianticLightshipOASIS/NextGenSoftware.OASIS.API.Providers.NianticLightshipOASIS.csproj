<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>NextGenSoftware.OASIS.API.Providers.NianticLightshipOASIS</PackageId>
        <Company>NextGen Software Ltd</Company>
        <Product>WEB4 OASIS API Niantic Lightship OASIS Provider</Product>
        <Title>WEB4 OASIS API Niantic Lightship OASIS Provider</Title>
        <Summary>Niantic Lightship AR SDK OASIS Map Provider -- AR-native geo-spatial mapping, VPS anchors, and real-world AR overlays for OASIS avatars and holons. https://oasisomniverse.one</Summary>
        <Description>Connects the OASIS to Niantic Lightship -- the industry-leading AR platform powering Pokemon GO and Ingress. Enables OASIS avatars and holons to be placed and experienced in the real world via AR overlays, VPS location anchors, and shared AR sessions. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
        <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
        <PackageIcon>OASIS.jpg</PackageIcon>
        <Authors>David Ellams (NextGen Software Ltd)</Authors>
        <PackageTags>OASIS API; Native; Integrated; WEB4; Provider; Niantic; Lightship; AR; Maps</PackageTags>
        <PackageReleaseNotes>- Initial release as part of OASIS Omniverse ecosystem expansion.
- Implements IOASISMapProvider for Niantic Lightship AR SDK.
- Upgraded to .NET 10.</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
        <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Version>2.0.1</Version>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
        <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

</Project>
