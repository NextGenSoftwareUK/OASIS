<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>NextGenSoftware.OASIS.API.Providers.HEREMapsOASIS</PackageId>
        <Company>NextGen Software Ltd</Company>
        <Product>WEB4 OASIS API HERE Maps OASIS Provider</Product>
        <Title>WEB4 OASIS API HERE Maps OASIS Provider</Title>
        <Summary>HERE Maps Enterprise Navigation OASIS Map Provider -- enterprise routing, real-time traffic, and geocoding for OASIS avatars and holons. https://oasisomniverse.one</Summary>
        <Description>Connects the OASIS to HERE Maps -- the enterprise-grade mapping and location platform trusted by automotive and logistics industries. Provides enterprise routing, real-time traffic, geocoding, and indoor positioning for OASIS avatars and holons. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
        <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
        <PackageIcon>OASIS.jpg</PackageIcon>
        <Authors>David Ellams (NextGen Software Ltd)</Authors>
        <PackageTags>OASIS API; Native; Integrated; WEB4; Provider; HERE; Maps; Navigation; Enterprise</PackageTags>
        <PackageReleaseNotes>- Initial release as part of OASIS Omniverse ecosystem expansion.
- Implements IOASISMapProvider for HERE Maps Platform.
- Upgraded to .NET 10.</PackageReleaseNotes>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
        <Copyright>Copyright © NextGen Software Ltd 2019 - 2026</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <Version>2.0.1</Version>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
        <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    </ItemGroup>

    <ItemGroup>
        <None Update="README.md">
            <PackagePath>\</PackagePath>
            <Pack>True</Pack>
        </None>
    </ItemGroup>

</Project>
