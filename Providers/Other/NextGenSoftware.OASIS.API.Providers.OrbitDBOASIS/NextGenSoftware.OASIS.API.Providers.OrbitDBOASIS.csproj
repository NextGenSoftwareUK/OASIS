<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NextGenSoftware.OASIS.API.Providers.OrbitDBOASIS</RootNamespace>
    <AssemblyName>NextGenSoftware.OASIS.API.Providers.OrbitDBOASIS</AssemblyName>
    <PackageId>NextGenSoftware.OASIS.API.Providers.OrbitDBOASIS</PackageId>
    <Company>NextGen World Ltd</Company>
    <Product>WEB4 OASIS API OrbitDB OASIS Provider</Product>
    <Title>WEB4 OASIS API OrbitDB OASIS Provider</Title>
    <Summary>OrbitDB OASIS Provider — decentralised peer-to-peer database on IPFS for OASIS holons and avatars. https://oasisomniverse.one</Summary>
    <Description>Connects the OASIS to OrbitDB via the orbit-db-http-api REST server. OrbitDB is a serverless, distributed, peer-to-peer database built on IPFS. Requires a running orbit-db-http-api server instance. No OrbitDB SDK required — uses System.Net.Http. Part of the OASIS HOT-Swappable Provider Architecture. Ecosystem: https://oasisomniverse.one</Description>
    <PackageProjectUrl>https://oasisomniverse.one</PackageProjectUrl>
    <PackageIcon>OASIS.jpg</PackageIcon>
    <Authors>David Ellams (NextGen World Ltd)</Authors>
    <PackageTags>OASIS API; OrbitDB; IPFS; Decentralised; P2P; WEB4; WEB5; Provider</PackageTags>
    <PackageReleaseNotes>- Initial release of OrbitDB OASIS provider.
- Requires orbit-db-http-api server (npm install -g orbit-db-http-api).
- Uses OrbitDB document store REST API — no Node.js SDK dependency from .NET.
- Stores OASIS holons and avatars as IPFS-backed document store entries.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/NextGenSoftwareUK/OASIS</RepositoryUrl>
    <Copyright>Copyright © NextGen World Ltd 2019 - 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <Nullable>enable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\Logos\OASIS.jpg" Link="OASIS.jpg">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj" Condition="Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <PackageReference Include="NextGenSoftware.OASIS.API.Core" Version="2.0.0" Condition="!Exists('..\..\..\OASIS Architecture\NextGenSoftware.OASIS.API.Core\NextGenSoftware.OASIS.API.Core.csproj')" />
    <ProjectReference Include="..\..\..\OASIS Architecture\NextGenSoftware.OASIS.Common\NextGenSoftware.OASIS.Common.csproj" />
  </ItemGroup>
</Project>
