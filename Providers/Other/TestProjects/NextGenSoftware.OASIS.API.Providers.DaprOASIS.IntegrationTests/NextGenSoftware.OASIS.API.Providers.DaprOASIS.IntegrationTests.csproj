<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../NextGenSoftware.OASIS.API.Providers.DaprOASIS/NextGenSoftware.OASIS.API.Providers.DaprOASIS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' == 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="DaprNativeStorageConformanceTests.cs" />
    <Compile Include="../../../Shared/TestSupport/CoreStorageConformance.cs" Link="TestSupport/CoreStorageConformance.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeStorageConformance)' != 'true'">
    <Compile Remove="DaprNativeStorageConformanceTests.cs" />
  </ItemGroup>
</Project>
